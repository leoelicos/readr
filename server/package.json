{
  "name": "readr-server",
  "version": "2.0.0",
  "private": true,
  "description": "Readr API: Express 5 + Apollo Server 5 + Mongoose, running TypeScript natively on Node 24.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@apollo/server": "^5.5.2",
    "@as-integrations/express5": "^1.1.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "graphql": "^16.11.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.18",
    "mongoose": "^9.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.4.0",
    "supertest": "^7.3.2",
    "typescript": "~7.0.2",
    "vitest": "^5.1.1"
  }
}
