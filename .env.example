# Server environment. Copy to server/.env for local development.
# Node loads it natively with --env-file-if-exists (no dotenv needed).

# MongoDB connection string (MongoDB Atlas in production). Defaults to a local mongod in development.
MONGODB_URI=mongodb://127.0.0.1:27017/readr

# REQUIRED in production: at least 32 random characters. Generate with:
#   node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
JWT_SECRET=

# How long a login lasts (jose time span, e.g. 2h, 7d).
JWT_TTL=2h

# Comma-separated list of browser origins allowed to call the API (e.g. your Vercel URL).
CORS_ORIGINS=http://localhost:5173

PORT=3001
